<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Saving the time-lapse video into Movies/Tree on Android 9 and older (MediaStore needs no
         permission for the app's own entries from Android 10 on). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 0.8 sharing: lets the game see whether any app takes a picture or a video (Android 11+
         package visibility) before it opens the share sheet. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application>
        <!-- Godot Android plugin v2 registration: singleton "TreePhone". -->
        <meta-data
            android:name="org.godotengine.plugin.v2.TreePhone"
            android:value="de.simonsouleyman.treephone.TreePhonePlugin" />

        <!-- Fired by AlarmManager once a day; posts the reminder and arms the next one. -->
        <receiver
            android:name="de.simonsouleyman.treephone.ReminderReceiver"
            android:exported="false" />

        <!-- Alarms are lost on reboot, time change and app update: re-arm them. -->
        <receiver
            android:name="de.simonsouleyman.treephone.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 0.8 sharing: serves the one shared Polaroid or video, read-only, to the app picked
             in the share sheet (a small FileProvider without androidx). -->
        <provider
            android:name="de.simonsouleyman.treephone.ShareProvider"
            android:authorities="${applicationId}.treeshare"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
